# Industrial Edge Environment Configuration Example
PORT=3000
NODE_ENV=production

# SQLite 3 Database Path
# For Render Persistent Disk: /var/data/industrial_edge.sqlite
# For Local Development: ./data/industrial_edge.sqlite
SQLITE_DB_PATH=./data/industrial_edge.sqlite

# Security & Authentication
JWT_SECRET=generate-a-secure-random-32-character-secret-here
ADMIN_JWT_SECRET=generate-a-secure-random-32-character-secret-here
