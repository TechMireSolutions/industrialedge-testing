# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# SQLite 3 Database Configuration
DB_TYPE=sqlite3
SQLITE_DB_PATH=../data/industrial_edge.sqlite

# Authentication & Security
JWT_SECRET=industrial-edge-super-secure-jwt-secret-key-32-chars-long!
JWT_EXPIRES_IN=7d
SALT_ROUNDS=10

# Asset Pipeline & CDN
UPLOAD_DIR=./uploads
CDN_BASE_URL=https://cdn.industrialedge.pk
MAX_FILE_SIZE_MB=10

# Email & Notifications (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=support@industrialedge.pk
ADMIN_NOTIFICATION_EMAIL=admin@industrialedge.pk

# System Currency & Country Defaults
DEFAULT_CURRENCY=PKR
DEFAULT_CURRENCY_SYMBOL=Rs.
DEFAULT_GST_PERCENTAGE=18.00
